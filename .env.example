TZ=Europe/Oslo

# source data on the docker host
IMMICH_LIBRARY_PATH=path-changeme

# backup target
BORG_REMOTE_USER=user-changeme
BORG_REMOTE_HOST=host-changeme
BORG_REPO_PATH=path-changeme

# retention
BORG_KEEP_DAILY=7
BORG_KEEP_WEEKLY=4
BORG_KEEP_MONTHLY=6

# secrets — fill these in your real .env, never commit
BORG_PASSPHRASE=changeme
